     "badge": null,
     "sizeFitSections": [],
     "title": "Nike Vomero 18",
     "subtitle": "Chaussure de running sur route pour homme",
     "fullTitle": "Chaussure de running sur route Nike Vomero 18 pour homme",
     "reasonToBuy": "La mousse double épaisseur te garantit une foulée plus souple que jamais et notre meilleur amorti.",
     "productDescription": "Amorti énorme. Découvre notre sneaker confortable pour tes runs quotidiens. Elle est plus souple et garantit un meilleur amorti avec une mousse ZoomX légère superposée à une mousse ReactX réactive dans la semelle intermédiaire. De plus, le motif d'adhérence repensé assure une transition fluide du talon à la pointe.",
     "moreDescriptions": [],
     "featuresAndBenefits": [],
     "enhancedBenefits": [
      {
       "header": "Empeigne en mesh tissé",
       "body": [
        "L'empeigne est en mesh tissé, une matière douce et respirante."
       ]
      },
      {
       "header": "Semelle intermédiaire double densité",
       "body": [
        "La semelle intermédiaire double densité intègre une mousse ZoomX superposée à une mousse ReactX 13 % plus réactive que la technologie React précédente. Le confort est total."
       ]
      },
      {
       "header": "Renforts autour de la semelle extérieure",
       "body": [
        "On a placé des renforts autour de la semelle extérieure pour améliorer l'agilité et favoriser des transitions fluides du talon à la pointe."
       ]
      },
      {
       "header": "Rembourrage confortable",
       "body": [
        "La languette et la doublure moelleuses sont très cosy."
       ]
      },
      {
       "header": "Quoi de neuf ?",
       "body": [
        "La nouvelle semelle intermédiaire en mousse superposée avec ZoomX premium et mousse ReactX donne encore plus de confort et d'amorti."
       ]
      }
     ],
