# Copia este archivo como .env y rellena lo que uses. .env no se sube al repositorio.

# Claude (plan B de la IA): API key de Anthropic.
ANTHROPIC_API_KEY=

# Modelos (opcionales). Por defecto: Haiku más reciente en Claude y el del CLI en Codex.
# CLAUDE_MODEL=claude-haiku-5-5
# CODEX_MODEL=

# Segundos máximos por análisis antes de pasar al otro proveedor.
# ARMARIO_AI_TIMEOUT=90

# Compras: "0" apaga el bucle que consulta las tiendas en su día de la semana (la consulta a mano sigue).
# ARMARIO_SHOP_AUTO=1
# Propuestas por tanda y pausa, en segundos, entre peticiones a la tienda.
# ARMARIO_SHOP_BATCH=40
# ARMARIO_SHOP_PAUSE=1.0
